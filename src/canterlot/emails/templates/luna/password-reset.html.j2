{% extends "luna/layout.html.j2" %}
{% import "macros.html.j2" as ui %}

{% block content %}
  {{ ui.salutation(recipient_name, punc=".") }}

  {% call ui.text_block() %}
    {% if is_creation %}
      We received a request to set up a password for your {{ ui.canterlot() }} account. Use the code below to choose your password.
    {% else %}
      We received a request to reset the password for your {{ ui.canterlot() }} account. Use the code below to choose a new password.
    {% endif %}
  {% endcall %}

  {{ ui.code_box(code) }}

  {% call ui.alert_box(type="warning") %}
    {% if is_creation %}
      The code expires in {{ expires_in_display }}. If you didn't request this setup, ignore this email — no action is needed.
    {% else %}
      The code expires in {{ expires_in_display }}. If you didn't request this reset, ignore this email — your password remains the same and no action is needed.
    {% endif %}
  {% endcall %}

  {{ ui.action_button(action_url, button_label) }}
{% endblock %}