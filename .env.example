# ==============================================================================
# ENVIRONMENT & GENERAL
# ==============================================================================
ENVIRONMENT=local
FRONTEND_URL=http://localhost:5173

# Admin credentials -- optional; only needed if accessing the admin sub-app.
# Defaults to "admin" / "admin" if unset.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin


# ==============================================================================
# AUTHENTICATION & SECURITY (AUTH__*)
# ==============================================================================
# REQUIRED -- A 32-byte (256-bit) secret key used for signing JWTs.
# Must be either a 64-char hex string (e.g., from `openssl rand -hex 32`) or Base64 (e.g., Render default).
# The value below is a placeholder, not a real key -- fine for local dev, generate your own for anything else.
AUTH__JWT_SECRET_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=

# REQUIRED -- A 32-byte (256-bit) secret key used for HMAC signing of sensitive tokens.
# Must be either a 64-char hex string or Base64.
# The value below is a placeholder, not a real key -- fine for local dev, generate your own for anything else.
AUTH__HMAC_SECRET_KEY=BBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBB=

# Optional -- Legal document versions. Must match the currently published terms/privacy policy.
AUTH__CURRENT_TERMS_VERSION=1
AUTH__CURRENT_PRIVACY_VERSION=1

# Optional -- Custom token expirations & TTLs (defaults shown)
# AUTH__JWT_ALGORITHM=HS256
# AUTH__ACCESS_TOKEN_EXPIRY_MINUTES=15
# AUTH__REFRESH_TOKEN_EXPIRY_DAYS=60
# AUTH__PASSWORD_RESET_COOKIE_MINUTES=15
# AUTH__VERIFICATION_PASSWORD_RESET_TTL_MINUTES=60
# AUTH__VERIFICATION_EMAIL_TTL_MINUTES=30


# ==============================================================================
# EMAIL SETTINGS (EMAIL__*)
# ==============================================================================
# Optional -- Defaults to true. When true, email payloads are logged to the console
# and NOT sent through external providers (safe for local development!).
EMAIL__DRY_RUN=true

# Optional -- Worker throughput rate limit for background email dispatching
EMAIL__DISPATCH_MAX_RPS=5

# Optional -- Live email sending via Resend. Leave empty in local dev!
EMAIL__RESEND_API_KEY=
# Optional -- Webhook signature verification. Leave empty in local dev.
EMAIL__RESEND_WEBHOOK_SECRET=


# ==============================================================================
# DATABASES & CONNECTIONS (DB__*)
# ==============================================================================
# REQUIRED -- Local or remote MongoDB & Redis connection strings.
DB__MONGODB_URL=mongodb://localhost:27017/
DB__MONGODB_DB_NAME=canterlot_db
DB__REDIS_URL=redis://localhost:6379/0


# ==============================================================================
# INTEGRATIONS & GATEWAYS (GATEWAYS__*)
# All provider integrations below are OPTIONAL for local development.
# ==============================================================================
# Optional -- External book search/details return 503 Service Unavailable if unset.
GATEWAYS__GOOGLE_BOOKS_API_KEY=

# Optional -- Google OAuth login/linking returns 503 if unset.
GATEWAYS__GOOGLE_OAUTH_CLIENT_ID=

# Optional -- Gravatar OAuth account linking (link only, not login).
# Both ID and Secret must be set together or Gravatar linking returns 503.
GATEWAYS__GRAVATAR_OAUTH_CLIENT_ID=
GATEWAYS__GRAVATAR_OAUTH_CLIENT_SECRET=


# ==============================================================================
# RATE LIMIT OVERRIDES (RATELIMIT__*) -- OPTIONAL
# All rate limits have default values configured in code. Override only if needed.
# ==============================================================================
# RATELIMIT__AUTH_REGISTER=5
# RATELIMIT__AUTH_LOGIN_IP=20
# RATELIMIT__AUTH_LOGIN_ACCOUNT=10
# RATELIMIT__AUTH_OAUTH_SIGNIN=20
# RATELIMIT__AUTH_REFRESH=30
# RATELIMIT__CLUB_OWNERSHIP_ACTION=10
# RATELIMIT__INVITE_CREATE_DIRECT=10